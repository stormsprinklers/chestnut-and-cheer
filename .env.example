# Public site URL (used for canonicals, Open Graph, sitemap, and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://utah.christmas

# CRM — Chestnut & Cheer website integration (from CRM seed / Settings → Integrations)
# Must point at the Chestnut & Cheer company WEBSITE key (not Storm Sprinklers).
# CRM_INTEGRATION_URL=https://your-crm-host/api/integrations
# CRM_INTEGRATION_KEY=crm_int_...

# Contact + estimate forms create CRM leads via POST {CRM_INTEGRATION_URL}/website/leads
# Online booking uses GET/POST {CRM_INTEGRATION_URL}/website/booking (same key, C&C org only)
# Sources: christmas-contact | christmas-estimate | share-the-cheer-nomination | share-the-cheer-partner
# Share the Cheer forms fail closed if the CRM or Turnstile variables are missing.

# Optional — Google Maps Places autocomplete on /estimate
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# OpenAI — required for /visualize Christmas lights preview (Images Edit API)
# OPENAI_API_KEY=sk-...

# Cloudflare Turnstile (spam / abuse protection on /estimate and /visualize)
# Use the existing widget secret — do not create another widget.
# TURNSTILE_SECRET=<from Cloudflare Turnstile dashboard>
TURNSTILE_SECRET=
# Optional override (defaults to the existing widget site key in code):
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAD_Sp0Ri6oKMkghT

# Optional — enable Google review badge + AggregateRating schema when set
# Google Business link defaults to https://g.page/r/CQXfzb_ziCg5EBM
# NEXT_PUBLIC_GOOGLE_REVIEWS_URL=https://g.page/r/CQXfzb_ziCg5EBM
# NEXT_PUBLIC_GOOGLE_REVIEW_RATING=5.0
# NEXT_PUBLIC_GOOGLE_REVIEW_COUNT=47
